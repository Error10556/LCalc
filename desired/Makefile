CXXFLAGS = -std=c++17 -Wall -Wextra
CXXFLAGS_BISON = $(CXXFLAGS) -Wno-unused-but-set-variable

OBJECTS = Absyn.o \
	ClassicPrettyPrinter.o \
	ContextFreePrettyPrinter.o \
	HaskellPrinter.o \
	PrinterCommon.o \
	SyntaxPrinter.o \
	Test.o \
	grammar.lex.o \
	grammar.tab.o

ARCHIVES = libgrammarParser.a libgrammarPrinter.a

BNFC_GENERATED = Absyn.cpp \
	Absyn.hpp \
	ClassicPrettyPrinter.cpp \
	ClassicPrettyPrinter.hpp \
	ContextFreePrettyPrinter.cpp \
	ContextFreePrettyPrinter.hpp \
	HaskellPrinter.cpp \
	HaskellPrinter.hpp \
	PatternMatching.hpp \
	PrinterCommon.cpp \
	PrinterCommon.hpp \
	SyntaxPrinter.cpp \
	SyntaxPrinter.hpp \
	Test.cpp \
	grammar.l \
	grammar.ypp \
	Makefile

TEST_DFLAGS =
ifneq ($(NO_PRETTY),)
TEST_DFLAGS += -DNO_PRETTY
endif
ifneq ($(NO_CPRETTY),)
TEST_DFLAGS += -DNO_CPRETTY
endif
ifneq ($(NO_TREE),)
TEST_DFLAGS += -DNO_TREE
endif
ifneq ($(NO_HASKELL),)
TEST_DFLAGS += -DNO_HASKELL
endif

LIBPRINTER_DEPS =
ifeq ($(NO_PRETTY),)
LIBPRINTER_DEPS += ContextFreePrettyPrinter.o
endif
ifeq ($(NO_CPRETTY),)
LIBPRINTER_DEPS += ClassicPrettyPrinter.o
endif
ifeq ($(NO_TREE),)
LIBPRINTER_DEPS += SyntaxPrinter.o
endif
ifeq ($(NO_HASKELL),)
LIBPRINTER_DEPS += HaskellPrinter.o
endif

TEST_PRINTER_HEADERS =
ifeq ($(NO_PRETTY),)
TEST_PRINTER_HEADERS += ContextFreePrettyPrinter.hpp
endif
ifeq ($(NO_CPRETTY),)
TEST_PRINTER_HEADERS += ClassicPrettyPrinter.hpp
endif
ifeq ($(NO_TREE),)
TEST_PRINTER_HEADERS += SyntaxPrinter.hpp
endif
ifeq ($(NO_HASKELL),)
TEST_PRINTER_HEADERS += HaskellPrinter.hpp
endif

define HELPMESSAGE
Phony targets:

TARGET        | DESCRIPTION
--------------|-----------------------------------------------------------------
help          | Print this message.
all (default) | Build the static libraries and the "Testgrammar" program.
mostlyclean   | Delete all object/executable files.
clean         | Delete all files created by this Makefile and BNFC backups.
distclean     | Delete ALL files generated by BNFC or this Makefile.

File targets:

TARGET              | DESCRIPTION
--------------------|-----------------------------------------------------------
Testgrammar         | A program that performs parsing and prints the AST.
libgrammarParser.a  | Implements the syntax tree, lexing, and parsing.
libgrammarPrinter.a | Implements pretty- and syntax-tree-printing.
grammar.lex.cpp     | Contains a lexer implementation.
grammar.tab.{h,c}pp | Contain a syntax parser implementation.

For any *.cpp file, a corresponding *.o file can be built.

Variables:

VARIABLE   | DESCRIPTION
-----------|--------------------------------------------------------------------
NO_PRETTY  | Set to a nonempty string to not use the ContextFreePrettyPrinter.
NO_CPRETTY | Set to a nonempty string to not use the ClassicPrettyPrinter.
NO_TREE    | Set to a nonempty string to not use the SyntaxPrinter.
NO_HASKELL | Set to a nonempty string to not use the HaskellPrinter.

The --systest option is available in the Testgrammar program when
ClassicPrettyPrinter and HaskellPrinter are available.
endef

.PHONY: all clean mostlyclean distclean default help

default: all

help:
	$(file >/dev/stdout,$(HELPMESSAGE))
	@:

all: $(ARCHIVES) Testgrammar

define NEWLINE



endef
MOSTLYCLEAN_FILES := $(OBJECTS) $(ARCHIVES) Testgrammar
BAKFILES := $(foreach f,$(BNFC_GENERATED),$(f).bak)
CLEAN_FILES := grammar.lex.cpp grammar.tab.cpp grammar.tab.hpp $(BAKFILES)

mostlyclean:
	$(foreach f,$(wildcard $(MOSTLYCLEAN_FILES)),rm $(f);$(NEWLINE))

clean: mostlyclean
	$(foreach f,$(wildcard $(CLEAN_FILES)),rm $(f);$(NEWLINE))

distclean: clean
	$(foreach f,$(wildcard $(BNFC_GENERATED)),rm $(f);$(NEWLINE))

grammar.lex.cpp: grammar.l
	flex grammar.l

grammar.tab.hpp grammar.tab.cpp &: grammar.ypp
	bison grammar.ypp

CXX_COMPILE = $(CXX) $(CXXFLAGS) -c -o $@ $<
Absyn.o: Absyn.cpp Absyn.hpp
	$(CXX_COMPILE)

grammar.tab.o: grammar.tab.cpp grammar.tab.hpp \
	Absyn.hpp PatternMatching.hpp
	$(CXX) $(CXXFLAGS_BISON) -c -o $@ $<

grammar.lex.o: grammar.lex.cpp grammar.tab.hpp
	$(CXX_COMPILE)

PrinterCommon.o: PrinterCommon.cpp PrinterCommon.hpp
	$(CXX_COMPILE)

HaskellPrinter.o: HaskellPrinter.cpp HaskellPrinter.hpp \
	Absyn.hpp PrinterCommon.hpp
	$(CXX_COMPILE)

ClassicPrettyPrinter.o: ClassicPrettyPrinter.cpp \
	ClassicPrettyPrinter.hpp Absyn.hpp PrinterCommon.hpp
	$(CXX_COMPILE)

ContextFreePrettyPrinter.o: ContextFreePrettyPrinter.cpp \
	ContextFreePrettyPrinter.hpp Absyn.hpp PrinterCommon.hpp
	$(CXX_COMPILE)

SyntaxPrinter.o: SyntaxPrinter.cpp SyntaxPrinter.hpp \
	Absyn.hpp PrinterCommon.hpp
	$(CXX_COMPILE)

AR_COMPILE = $(AR) $(ARFLAGS) $@ $^
libgrammarParser.a: Absyn.o grammar.lex.o grammar.tab.o
	$(AR_COMPILE)

libgrammarPrinter.a: $(LIBPRINTER_DEPS)
	$(AR_COMPILE)

Test.o: Test.cpp Absyn.hpp grammar.tab.hpp PatternMatching.hpp $(TEST_HEADERS)
	$(CXX_COMPILE)

Testgrammar: Test.o libgrammarParser.a libgrammarPrinter.a
	$(CXX) $(LDFLAGS) $^ -o Testgrammar
