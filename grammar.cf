AProgram. Program ::= [Expr];
separator Expr ";";

coercions Expr 2;
Abstraction. Expr ::= "l" Ident "." Expr;
Application. Expr1 ::= Expr1 Expr2;
Variable. Expr2 ::= Ident;
id. Expr2 ::= "id" "<" Ident ">";
const. Expr2 ::= "const" "<" Ident ">";

entrypoints Program;

comment "//";
comment "/*" "*/";

StringExpr. Expr ::= "str:" String;
IntegerExpr. Expr ::= "int:" Integer;
DoubleExpr. Expr ::= "dbl:" Double;
CharExpr. Expr ::= "chr:" Char;

token SpecialBegin {"<:"} (digit - '0')+;
position token SpecialEnd (digit - '0')+ {":>"};
SpecialExpr. Expr ::= SpecialBegin Expr SpecialEnd;

define id varname = Abstraction varname (Variable varname);
define const varname = Abstraction varname (id varname);
